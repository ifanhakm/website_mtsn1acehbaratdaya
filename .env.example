# Public site URL. Include the protocol and do not add a trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Required server-only settings.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
DATABASE_URI=postgresql://user:password@host:5432/database
SCHOOL_EMAIL=website.mtsn1abdya@gmail.com
RESEND_API_KEY=re_replace_me
# Use a sender from a domain verified in Resend for production email delivery.
RESEND_FROM_EMAIL=onboarding@resend.dev

# PostgreSQL TLS is enabled and certificates are verified by default.
# Use "require" only when a managed pooler has a private/self-signed CA.
# Set to false only for a trusted local database without TLS.
DATABASE_SSL=true
# Batas aman untuk satu container VPS yang memakai Supavisor session mode.
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Sedikit lebih panjang dari statement timeout agar pembatalan terjadi di PostgreSQL lebih dahulu.
DATABASE_QUERY_TIMEOUT_MS=12000
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
# Jangan aktifkan terhadap database production; gunakan migrasi terkontrol.
ALLOW_DEV_SCHEMA_PUSH=false
# Aktifkan hanya setelah prosedur baseline migrasi pada deploy/README.md selesai.
RUN_DATABASE_MIGRATIONS=false

# Optional Supabase S3-compatible storage. When all values are present,
# Payload stores media and documents in the bucket instead of local disk.
SUPABASE_URL=https://hwvcfplrligtefwazxkt.supabase.co
SUPABASE_BUCKET_NAME=media
SUPABASE_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY_ID=replace-me
SUPABASE_S3_SECRET_ACCESS_KEY=replace-me
